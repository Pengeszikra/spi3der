{
  "name": "spi3der",
  "version": "26.11.24004",
  "description": "Browser-native 3D scene building, WebXR and ViRtuSH, based on 3Draft",
  "brand": {
    "repo": "Pengeszikra/spi3der",
    "branch": "main",
    "site": "https://spi3der.cloud.run",
    "mcp": "https://spi3der.cloud.run/mcp",
    "own": [
      "models/",
      "docs/",
      ".github/",
      "APP.md",
      "scripts/from-spider.mjs",
      "scripts/bootstrap-from-five-percent.mjs"
    ],
    "share": [
      "models/spider-build-v2.mjs",
      "models/spider-build-v2.md",
      "models/spider-build-v2.schema.json"
    ]
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "spi3der": "./bin/spi3der.mjs",
    "spi3der-workshop-mcp": "./bin/workshop-mcp.mjs"
  },
  "scripts": {
    "start": "node bin/spi3der.mjs",
    "test": "node tests/math.mjs && node tests/smoke.mjs && node tests/instance.mjs",
    "test:all": "node scripts/test-all.mjs",
    "bump": "node scripts/bump.mjs",
    "workshop": "node bin/workshop.mjs",
    "test:workshop": "node tests/workshop.mjs",
    "mcp:workshop": "node bin/workshop-mcp.mjs",
    "test:mcp-app": "node tests/mcp-app.mjs",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "node scripts/check-publish.mjs",
    "transfer": "node scripts/transfer.mjs",
    "brand": "node scripts/transfer.mjs --brand"
  },
  "files": [
    "api/",
    "mcp/",
    "bin/",
    "engine/",
    "icons/",
    "media/",
    "models/",
    "src/",
    "index.html",
    "player.html",
    "emulator.html",
    "sky.html",
    "xr-test.html",
    "xr-compare.html",
    "sky.md",
    "help.md",
    "PLAYER.md",
    "APP.md",
    "MCP.md",
    "favicon.svg",
    "manifest.webmanifest",
    "sw.js",
    "Dockerfile",
    "nginx.conf",
    "README.md",
    "workshop.html",
    "LICENSE",
    "TRANSFER.md"
  ],
  "dependencies": {
    "@vercel/blob": "^2.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
